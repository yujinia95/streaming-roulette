# TMDB v3 API key — get one free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Origin allowed to call this API (your deployed frontend URL in production)
FRONTEND_ORIGIN=http://localhost:5500

# Namespace/key used on the free hosted spin-counter API (any values you like)
COUNTER_NAMESPACE=streaming-roulette
COUNTER_KEY=spins
